{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{"key": "Content-Type", "value": "application/json"}]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{"key": "Content-Type", "value": "application/json"}]
    }
  ],
  "rewrites": [
    {
      "source": "/invite/:path*",
      "destination": "/invite"
    }
  ]
}
