# BooKoo environment reference.
#
#   cp .env.example .env.local     # then fill it in; .env.local is gitignored
#
# .gitignore ignores every `.env*` EXCEPT this file. Never put a real value here.
#
# NOTE ON "PUBLIC": anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript
# bundle at build time and is readable by anyone who downloads the app. That is
# fine for OAuth client ids and app keys, which are public by design. It is NOT
# fine for anything that grants server-side authority — those live only in the
# Convex dashboard (bottom section).

# --- Convex ------------------------------------------------------------------
# Normally written by `bunx convex dev` on first run. When a project already
# exists in the dashboard, these three non-secret identifiers can be copied
# from that deployment without running a deploy.
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
# The .convex.site origin (not .convex.cloud). Used by the Apple web callback.
EXPO_PUBLIC_CONVEX_SITE_URL=

# --- Deep links --------------------------------------------------------------
# Host for invite links: https://<host>/invite/<token>
# Must match `ios.associatedDomains` + the Android intentFilter in app.config.ts,
# and the domain must serve /.well-known/apple-app-site-association + assetlinks.json.
EXPO_PUBLIC_APP_DOMAIN=bookoo.hyo.dev

# --- Social sign-in ----------------------------------------------------------
# Kakao: developers.kakao.com → 내 애플리케이션 → 앱 키 → 네이티브 앱 키
# app.config.ts only mounts the Kakao plugin when this is set, so a missing value
# disables Kakao login rather than shipping a placeholder into Info.plist.
EXPO_PUBLIC_KAKAO_APP_KEY=
# Kakao: 같은 앱의 REST API 키. Kakao OIDC 토큰의 audience가 이 값으로
# 발급되는 경로도 있으므로 네이티브 앱 키와 함께 설정합니다.
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# Naver: developers.naver.com → 애플리케이션 → 로그인 오픈 API
# The URL scheme is hardcoded to `bookoonaver` in app.config.ts — it must NOT be
# the app's own scheme, because the Naver plugin consumes every URL on its scheme
# before expo-router sees it.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# Google: console.cloud.google.com → APIs & Services → Credentials.
# Create three OAuth client ids. The WEB one is the audience of the ID token and
# is required even though the app is native.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps Platform SDK keys used only by the optional entry-place picker.
# Restrict each key to this app's bundle/package id and the matching Maps SDK.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Apple: developer.apple.com → Identifiers → Services IDs.
# Only needed for the Apple-on-Android web flow; native iOS uses the bundle id.
# Empty here means Android Continue with Apple must stay disabled. The matching
# Convex `APPLE_SERVICE_ID` and Return URL
# `https://<deployment>.convex.site/auth/apple/callback` also have to exist.
EXPO_PUBLIC_APPLE_SERVICE_ID=dev.hyo.bookoo.web

# --- OpenIAP + IAPKit (ledger subscription) ----------------------------------
# Native purchases use expo-iap. No billing API key is embedded in the app.
# Both IAPKit keys and its signing secret live only in Convex environment vars.

# --- Ad consent and Unity LevelPlay (free tier only) --------------------------
# Google app IDs support UMP consent only; BooKoo never initializes AdMob or
# requests Google ads. Keep the NEW dev.hyo.bookoo app records for this purpose.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# Public SDK identifiers from BooKoo's own LevelPlay apps, never Martie's IDs.
# Every build fails closed without its platform's app key and banner unit.
# QA devices must be enrolled in the LevelPlay test-device dashboard.
EXPO_PUBLIC_LEVELPLAY_IOS_APP_KEY=
EXPO_PUBLIC_LEVELPLAY_IOS_BANNER_ID=
EXPO_PUBLIC_LEVELPLAY_ANDROID_APP_KEY=
EXPO_PUBLIC_LEVELPLAY_ANDROID_BANNER_ID=

# --- Layers (growth attribution) ---------------------------------------------
# Layers app id, issued from the workspace's Connections > Layers SDK card once
# the org is on a paid plan. Not a secret: it identifies the app to the ingest
# endpoint the way an AdMob unit id does, and it is EXPO_PUBLIC because the SDK
# reads it on the device.
#
# Blank is a supported state, not a broken one. GrowthAnalyticsProvider renders
# its children untouched without it, so every checkout, CI run and web build
# works with no attribution rather than failing. Set it only in the EAS
# `production` environment; `preview` builds that carry it report into Layers'
# `staging` environment automatically so QA installs stay out of the numbers.
EXPO_PUBLIC_LAYERS_APP_ID=

# --- EAS ---------------------------------------------------------------------
# Optional local override. app.config.ts defaults to the checked-in, non-secret
# @cpk-org/bookoo project id so EAS can resolve the project before cloud env is loaded.
EAS_PROJECT_ID=

# --- Codemagic store builds ----------------------------------------------------
# Store build number (iOS CFBundleVersion / Android versionCode) for builds made
# outside EAS. Codemagic sets it above the latest uploaded store build; EAS
# builds keep their remote numbers and leave it unset.
BOOKOO_BUILD_NUMBER=

# --- Local simulator state verification --------------------------------------
# Development-only switches used to capture otherwise conditional UI states.
# Leave both blank for ordinary development and every release candidate.
# FORCE_OFFLINE makes writes fail visibly without sending or queueing them.
# SESSION_STAGE accepts only: locked, pending-deletion, suspended.
EXPO_PUBLIC_E2E_FORCE_OFFLINE=
EXPO_PUBLIC_E2E_SESSION_STAGE=
EXPO_PUBLIC_E2E_ONBOARDING_STEP=

# --- Maestro E2E (export in the local shell; never commit real mailboxes) ------
# Used by `.maestro/*auth*` flows. Development OTP is the Convex
# ENVIRONMENT=development code, not a production reviewer code.
BOOKOO_E2E_OWNER_EMAIL=
BOOKOO_E2E_EMAIL=
BOOKOO_E2E_OTP=

# --- Convex dashboard only — NEVER in this file, NEVER in the bundle ----------
# Set with: bunx convex env set <NAME> <value>
#
#   AUTH_RESEND_KEY     Resend API key, backs the email-OTP provider
#   JWT_PRIVATE_KEY     Convex Auth signing key   (generated by @convex-dev/auth init)
#   JWKS                Convex Auth public JWKS   (generated by @convex-dev/auth init)
#   SITE_URL            The .convex.site origin
#   GOOGLE_IOS_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID / GOOGLE_WEB_CLIENT_ID
#                       Mirrors of the public Google client ids
#   KAKAO_NATIVE_APP_KEY / KAKAO_REST_API_KEY
#                       Mirrors of the public Kakao app keys
#   APPLE_SERVICE_ID    Apple Services ID
#   APPLE_TEAM_ID       Apple Developer Team ID
#   APPLE_KEY_ID        Apple private key id (Sign in with Apple)
#   APPLE_PRIVATE_KEY   Apple .p8 contents — required to REVOKE a token on
#                       account deletion (App Store guideline 5.1.1(v))
#   INVITE_TOKEN_PEPPER 32 random bytes (hex); hashes bearer invite codes
#   ENVIRONMENT         `development` enables the all-email 68686868 QA OTP;
#                       `production` disables that development-only path
#   RESEND_FROM_EMAIL   The From: address for OTP mail. WITHOUT IT the sender
#                       falls back to Resend's shared `onboarding@resend.dev`
#                       sandbox domain, which is not a deliverable production
#                       sender. Set it before any public release.
#   APP_REVIEW_FIXED_OTP_EMAILS
#   APP_REVIEW_FIXED_OTP_CODE
#                       The App Store / Play reviewer sign-in path: a comma
#                       separated list of reviewer addresses, plus the fixed
#                       code accepted for them. WITHOUT THESE A REVIEWER CANNOT
#                       SIGN IN, because they have no access to the OTP inbox —
#                       a standard Guideline 2.1 rejection. Unlike the
#                       development-only 68686868 path this works in production,
#                       so keep the address list minimal and rotate the code
#                       after review.
#   MIGRATION_SECRET    >=32 chars. Gates `migrationMutation`; the legacy import
#                       tooling is inert without it.
#   TRASH_PURGE_MODE    Unset/off: the nightly trash purges do nothing.
#                       dry_run: log what would be destroyed, delete nothing.
#                       enforce: destroy trashed entries and deleted ledgers
#                       30 days after deletion, as the privacy policy states.
#                       Rollout steps: .notes/design/trash-purge.md.
#   RETENTION_PURGE_MODE
#                       Same three values, separate switch. enforce: destroy
#                       FEED audit rows, notifications, authAudit rows and
#                       superseded consent records after 180 days, and offline
#                       update receipts at their 30-day expiry.
#   UPLOAD_SWEEP_MODE   Same three values, separate switch. enforce: delete
#                       claimed uploads (blob and row) that nothing references
#                       24 hours after the claim.
#                       Both: .notes/design/retention-purge.md.
#   APPLE_BUNDLE_ID     Comma-separated Apple audiences accepted by the server
#                       token verifier (`convex/lib/idToken.ts`).
#   GOOGLE_ANDROID_CLIENT_ID / GOOGLE_WEB_CLIENT_ID
#                       The other two Google audiences. `GOOGLE_IOS_CLIENT_ID`
#                       alone is not enough: Android and web sign-in fail
#                       verification without their own entries.
#   KAKAO_REST_API_KEY  Kakao audience for the same verifier. Note this is the
#                       NON-prefixed name — the server reads this, while the
#                       client reads `EXPO_PUBLIC_KAKAO_REST_API_KEY`.
#
# Provided automatically by the platform, never set by hand:
#   CONVEX_SITE_URL     Convex injects the deployment's .convex.site origin.
#   NODE_ENV            Set by the bundler/runtime.
#   IAPKIT_SANDBOX_APP_USER_IDS
#                       Optional server-only comma-separated allowlist (max 32)
#                       of exact reviewer/test Convex user IDs. Allows verified,
#                       expiring Apple Sandbox receipts on production without
#                       overriding real purchases. Empty disables the exception.
#   IAPKIT_PUBLISHABLE_KEY
#                       Verification + immutable purchase/user binding. Backend only.
#   IAPKIT_SECRET_KEY    Secret admin key for authenticated tokenless v2 status
#                       and account erasure. NEVER EXPO_PUBLIC_ or in a native plugin.
#   IAPKIT_WEBHOOK_SECRET
#                       HMAC-SHA256 secret for this deployment's signed destination.
#   IAPKIT_PROJECT_ID    Expected provider project in every signed event.
#   IAPKIT_EXPECTED_ENVIRONMENT
#                       SANDBOX (development) or PRODUCTION (production).
