{
  "name": "bookoo",
  "version": "1.5.0",
  "description": "BooKoo — shared ledger app",
  "main": "expo-router/entry",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node plugins/patchGoogleMobileAds.mjs",
    "prepare": "sh scripts/install-git-hooks.sh || true",
    "start": "BOOKOO_APP_VARIANT=qa expo start",
    "start:clear": "BOOKOO_APP_VARIANT=qa expo start -c",
    "android": "zsh scripts/run-qa.zsh android",
    "ios": "zsh scripts/run-qa.zsh ios",
    "ios:device": "zsh scripts/run-qa.zsh ios --device",
    "growth:report": "bun scripts/growth/activity-report.ts",
    "web": "expo start --web",
    "prebuild": "expo prebuild --no-install",
    "dev:convex": "convex dev",
    "dev:convex:once": "convex dev --once",
    "deploy:convex": "convex deploy",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx --no-error-on-unmatched-pattern src app test convex shared scripts plugins",
    "lint:i18n": "eslint --ext .json --format node_modules/eslint-plugin-i18n-json/formatter.js assets/langs/",
    "fix:i18n": "eslint --fix --ext .json --format node_modules/eslint-plugin-i18n-json/formatter.js assets/langs/",
    "verify:langs": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-langs.ts",
    "verify:dependencies": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-dependencies.ts",
    "verify:secrets": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-secrets.ts",
    "verify:schema": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/lint-schema.ts",
    "verify:readiness": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-readiness.ts",
    "verify:store": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/verify-store-metadata.ts",
    "perf:load": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/perf/load-ledger.ts",
    "public:generate": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/generate-public-site.ts",
    "verify:public": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/generate-public-site.ts --check",
    "lint:all": "bun lint && bun lint:i18n && bun run verify:langs && bun run verify:dependencies && bun run verify:secrets && bun run verify:schema && bun run verify:public && bun run verify:store && bun run verify:readiness",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "bun lint && bun typecheck && bun run test",
    "fix:deps": "expo install --fix",
    "doctor": "expo-doctor",
    "eas:preview:android": "eas build --profile preview --platform android --local",
    "eas:preview:ios": "scripts/eas-local-ios.zsh preview",
    "eas:purchase-test:android": "NODE_ENV=production bunx eas-cli@23.0.0 build --profile purchase-test --platform android --local",
    "eas:prod:android": "scripts/eas-local-production.zsh android",
    "eas:prod:ios": "scripts/eas-local-ios.zsh production",
    "ota:release": "scripts/ota-release.zsh all",
    "ota:release:ios": "scripts/ota-release.zsh ios",
    "ota:release:android": "scripts/ota-release.zsh android"
  },
  "dependencies": {
    "@codemagic/react-native-patch": "0.7.0",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/workpool": "0.4.10",
    "@expo/match-media": "0.4.0",
    "@expo/react-native-action-sheet": "4.1.1",
    "@expo/vector-icons": "15.1.1",
    "@layers/expo": "^3.3.1",
    "@noble/hashes": "2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-native-seoul/kakao-login": "6.0.4",
    "@react-native-seoul/naver-login": "5.0.1",
    "@shopify/flash-list": "2.3.3",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "cpk-ui": "0.8.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "12.0.3",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-iap": "6.4.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "57.0.20",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.22",
    "expo-maps": "~57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.24",
    "expo-observe": "~57.0.26",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "4.5.3",
    "jose": "6.2.10",
    "kstyled": "0.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-error-boundary": "3.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.5.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "3.3.3",
    "react-native-pager-view": "8.0.2",
    "react-native-play-install-referrer": "2.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "unity-levelplay-mediation": "9.4.0",
    "zustand": "5.0.15"
  },
  "overrides": {
    "expo-constants": "$expo-constants"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-plugin-kstyled": "0.4.1",
    "commitlint-plugin-function-rules": "^5.0.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18n-json": "^4.0.1",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "oslo": "1.2.1",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "sharp": "0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "cpk-ui",
          "kstyled"
        ]
      }
    }
  }
}
