# .easignore — what is stripped from the tarball uploaded to EAS Build.
#
# When this file exists, EAS uses it INSTEAD of .gitignore
# (https://github.com/expo/eas-cli/issues/1253). So everything .gitignore
# hides has to be repeated here, plus the extras that must not travel.
#
# Matching is gitignore semantics: the LAST pattern that matches a path wins,
# and a negation (`!`) can only re-include a file whose parent directories are
# still included. That is why the excludes below are written as `dir/*`
# (children only) and never `dir/` (the directory itself) whenever something
# inside has to be re-included afterwards.

# OSX
.DS_Store

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace

# Android/IntelliJ
.idea
.gradle
local.properties
*.iml
*.hprof

# node.js — EAS installs dependencies itself
node_modules/
npm-debug.log
yarn-error.log

# BUCK
buck-out/
\.buckd/
*.keystore
*.jks

# Local signing is consumed separately by EAS/the IPA export helper, never
# from the application source archive. .gitignore is not inherited here.
/credentials.json
/credentials/
*.p12
*.p8
*.mobileprovision

# fastlane
*/fastlane/report.xml
*/fastlane/Preview.html
*/fastlane/screenshots

# Bundle artifacts
*.jsbundle

# CocoaPods
/ios/Pods/

# Expo
.expo/*
web-build/
dist/

# Yarn
.yarn/*
!.yarn/releases

# ── env files ────────────────────────────────────────────────────────────────
# EAS Environment Variables are the only build-time secret source. Strip every
# local/staged `.env*`; `.env.example` carries names and empty examples only.
.env*
!.env.example

.jest

# ── native projects ──────────────────────────────────────────────────────────
# Not committed; EAS runs `expo prebuild` itself.
/android
/ios
*.aab

# ── Convex ───────────────────────────────────────────────────────────────────
# The Convex backend is deployed separately (`bunx convex deploy`), so the
# function source does not belong in the app bundle — but the client imports
# `@convex/_generated/api`, so the generated API MUST ship.
# `convex/*` (not `convex/`) keeps the directory itself included so the
# following negation can take effect.
convex/*
!convex/_generated

# ── repo-only material ───────────────────────────────────────────────────────
# Legacy 2017 app kept read-only for reference; design notes; and the whole
# scripts/ tree (including scripts/migrate/ and anything it writes). The native
# legal screens share the generated public-site copy, so content.ts and every
# module it imports (discovery.ts and the store locale registry it reads) must
# travel with the app bundle; Metro fails the native build without them.
BooKooLegacy/
.local/
.notes/
docs/
/store-assets/*
!/store-assets/store-locales.json
/scripts/*
!/scripts/public-site
/scripts/public-site/*
!/scripts/public-site/content.ts
!/scripts/public-site/discovery.ts
*.log

# ── agent / tooling config ───────────────────────────────────────────────────
.agents/
.claude/
.codex/
.grok/
.cursor/
.github/
.vscode/
test/
__mocks__/
coverage/

